package-as: TheGuild

move-folders:
  TheGuild/Modules/Map: TheGuild_Map
  TheGuild/Modules/Roster: TheGuild_Roster
  TheGuild/Modules/Alerts: TheGuild_Alerts
  TheGuild/Modules/Social: TheGuild_Social
  TheGuild/Modules/Professions: TheGuild_Professions
  TheGuild/Modules/Raids: TheGuild_Raids
  TheGuild/Modules/Loot: TheGuild_Loot
  TheGuild/Modules/Board: TheGuild_Board
  TheGuild/Modules/Stats: TheGuild_Stats
  TheGuild/Modules/Recruit: TheGuild_Recruit
  TheGuild/Modules/Voice: TheGuild_Voice

ignore:
  - tools
  - README.md
  - README.de.md
  - ROADMAP.md
  - Screenshots
  - .github
